---
import Layout from "~/layouts/PageLayout.astro";
import TalkListItem from "~/components/widgets/TalkListItem.astro";

import { getTalks } from "~/utils/getTalksCollection";

const page = await getTalks();

const meta = {
  title: "Talks — Ibrahim Cesar",
  description:
    "Public talks and speaking engagements by Ibrahim Cesar on cloud architecture, AWS, and software engineering.",
};
---

<Layout meta={meta}>
<section class="px-4 sm:px-6 py-8 sm:py-16 lg:py-20 mx-auto max-w-2xl sec-talks" aria-label="Talks">
  <header>
    <h1
      class="text-center text-5xl md:text-[3.50rem] font-bold leading-tighter tracking-tighter mb-8 md:mb-16 text-slate-900 dark:text-white"
    >
      {"{"} Public Talks {"}"}
    </h1>
  </header>
  <ul>
    {
      page.map((talk) => (
        <li class="mb-10 md:mb-16">
          <TalkListItem talk={talk} />
        </li>
      ))
    }
  </ul>
</section>
</Layout>

