{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "language": {
      "default": "pt-br",
      "type": "string",
      "enum": [
        "en",
        "pt-br"
      ]
    },
    "image": {
      "type": "string"
    },
    "socialImage": {
      "type": "string"
    },
    "tags": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "category": {
      "type": "string"
    },
    "author": {
      "default": "Ibrahim Cesar",
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "excerpt": {
      "type": "string"
    },
    "canonicalURL": {
      "type": "string",
      "format": "uri"
    },
    "series": {
      "type": "string"
    },
    "seriesOrder": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "relatedPosts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tableOfContents": {
      "default": true,
      "type": "boolean"
    },
    "showComments": {
      "default": true,
      "type": "boolean"
    },
    "discussionUrl": {
      "type": "string",
      "format": "uri"
    },
    "tldr": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate"
  ]
}