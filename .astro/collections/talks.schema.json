{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "eventDate": {
      "type": "string"
    },
    "videoTime": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string",
      "format": "uri"
    },
    "slidesUrl": {
      "type": "string",
      "format": "uri"
    },
    "event": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "language": {
      "default": "pt-br",
      "type": "string",
      "enum": [
        "en",
        "pt-br"
      ]
    },
    "tags": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "pubDate"
  ]
}